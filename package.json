{
  "name": "bloxhome",
  "version": "1.0.0",
  "description": "Eudora",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bloxhome.app",
    "productName": "Eudora",
    "files": [
      "main.js",
      "preload.js",
      "media-helper.ps1",
      "renderer/**/*",
      "bloxhome.config.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "media-helper.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eudora",
      "artifactName": "Eudora-Setup.${ext}"
    }
  },
  "author": "Eudora"
}